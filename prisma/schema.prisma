// JobPilot AI data model.
// Postgres everywhere: local Docker (see docker-compose.yml) and Neon on Vercel.
// DATABASE_URL is the runtime connection (pooled on Neon).
// DIRECT_URL is the unpooled connection Prisma uses for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  headline           String    @default("")
  location           String    @default("")
  yearsExperience    Int       @default(0)
  currentTitle       String    @default("")
  seniority          String    @default("")
  targetCompensation String    @default("")
  timezone           String    @default("UTC")
  currency           String    @default("USD")
  emailVerified      DateTime?
  trialEndsAt        DateTime?
  marketingConsent   Boolean   @default(false)
  pastedProfile      String    @default("")
  headlineSuggestion String    @default("")
  aboutSuggestion    String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  niches                Niche[]
  jobs                  Job[]
  resumes               Resume[]
  coverLetters          CoverLetter[]
  companies             TargetCompany[]
  contacts              Contact[]
  cars                  CarStatement[]
  skills                Skill[]
  posts                 LinkedInPost[]
  decks                 PitchDeck[]
  interviews            InterviewSession[]
  negotiations          NegotiationSession[]
  reminders             Reminder[]
  messages              ChatMessage[]
  pushSubs              PushSubscription[]
  templates             OutreachTemplate[]
  swot                  SwotReport?
  subscription          Subscription?
  aiUsage               AiUsage[]
  authTokens            AuthToken[]
  preferences           JobPreferences?
  billing               BillingAccount?
  consents              ConsentRecord[]
  upiPayments           UpiPayment[]
  huntCompanies         HuntCompany[]
  huntSettings          HuntSettings?
  huntRuns              HuntRun[]
  huntJobs              HuntJob[]
  resumeVersions        ResumeVersion[]
  notices               UserNotice[]
  savedAnswers          SavedAnswer[]
  onboardingStep        Int                  @default(0)
  onboardingCompletedAt DateTime?
}

/// One Stripe subscription per user. Written only by the Stripe webhook.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  /// "pro_monthly" | "pro_annual" | "" when unknown
  plan                 String    @default("")
  /// Stripe status: trialing, active, past_due, canceled, unpaid, incomplete, incomplete_expired, paused
  status               String    @default("incomplete")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  currency             String    @default("usd")
  /// Monthly-normalised amount in minor units, used for the admin MRR figure.
  mrrCents             Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// Processed Stripe event ids, so webhook retries are idempotent.
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// AI actions used per calendar month (UTC), for plan limits.
model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  period String
  count  Int    @default(0)

  @@unique([userId, period])
}

/// Single-use email verification and password reset tokens (sha256 hashed).
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}

model Niche {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  title           String
  aliases         String   @default("[]")
  industries      String   @default("[]")
  seniority       String   @default("")
  roleCategory    String   @default("")
  functionName    String   @default("")
  companyTypes    String   @default("[]")
  locations       String   @default("[]")
  workModes       String   @default("[]")
  targetCompanies String   @default("[]")
  includeKeywords String   @default("[]")
  excludeKeywords String   @default("[]")
  why             String   @default("")
  payBenchmark    String   @default("")
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  jobs            Job[]

  @@index([userId])
}

model Job {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nicheId      String?
  niche        Niche?        @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  title        String
  company      String
  location     String        @default("")
  workMode     String        @default("")
  experience   String        @default("")
  salary       String        @default("")
  url          String        @default("")
  source       String        @default("manual")
  description  String        @default("")
  status       String        @default("SAVED")
  fitScore     Int?
  fitBand      String        @default("")
  fitDetail    String        @default("{}")
  keywords     String        @default("[]")
  notes        String        @default("")
  archived     Boolean       @default(false)
  appliedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  contacts     Contact[]
  coverLetters CoverLetter[]
  reminders    Reminder[]
  drafts       StageDraft[]

  @@index([userId, status])
}

model StageDraft {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind      String
  content   String
  createdAt DateTime @default(now())

  @@index([jobId, kind])
}

model TargetCompany {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  industry  String      @default("")
  website   String      @default("")
  location  String      @default("")
  notes     String      @default("")
  status    String      @default("RESEARCHING")
  problems  String      @default("[]")
  createdAt DateTime    @default(now())
  contacts  Contact[]
  decks     PitchDeck[]

  @@index([userId])
}

model Contact {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   TargetCompany?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  jobId     String?
  job       Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  name      String
  title     String            @default("")
  email     String            @default("")
  linkedin  String            @default("")
  type      String            @default("POTENTIAL_REFERRER")
  tags      String            @default("[]")
  notes     String            @default("")
  createdAt DateTime          @default(now())
  messages  OutreachMessage[]

  @@index([userId])
}

model OutreachMessage {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  step      String
  body      String
  status    String   @default("DRAFT")
  updatedAt DateTime @updatedAt

  @@index([contactId, step])
}

model OutreachTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  step   String
  name   String
  body   String

  @@unique([userId, step])
}

model Resume {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  template     String        @default("executive")
  isPrimary    Boolean       @default(false)
  rawText      String        @default("")
  content      String        @default("{}")
  fileName     String        @default("")
  mimeType     String        @default("")
  fileUrl      String        @default("")
  fileData     Bytes?
  score        Int?
  scoreDetail  String        @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  coverLetters CoverLetter[]
  versions     ResumeVersion[]

  @@index([userId])
}

/// ATS-enhanced versions of an uploaded resume. The original Resume row is never modified.
model ResumeVersion {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId   String
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version    Int
  targetRole String   @default("")
  content    String   @default("{}")
  atsBefore  Int      @default(0)
  atsAfter   Int      @default(0)
  /// JSON: {changes:[{kind,section,before,after}], before:{...}, after:{...}, keywords:{matched,missing}}
  detail     String   @default("{}")
  createdAt  DateTime @default(now())

  @@unique([resumeId, version])
  @@index([userId, createdAt])
}

model CoverLetter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  resumeId  String?
  resume    Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  title     String
  template  String   @default("letterhead")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CarStatement {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      String
  role         String
  challenge    String
  action       String
  result       String
  skills       String   @default("[]")
  resumeBullet String   @default("")
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Skill {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  category String
  level    Int    @default(3)
  variants String @default("[]")
  source   String @default("profile")

  @@index([userId])
}

model SwotReport {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strengths     String   @default("[]")
  weaknesses    String   @default("[]")
  opportunities String   @default("[]")
  threats       String   @default("[]")
  actions       String   @default("[]")
  updatedAt     DateTime @updatedAt
}

model LinkedInPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     String
  content   String
  weekOf    String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())

  @@index([userId, weekOf])
}

model PitchDeck {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?
  company     TargetCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyName String
  problem     String
  slides      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
}

model InterviewSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  title     String
  mode      String   @default("behavioral")
  questions String   @default("[]")
  report    String   @default("{}")
  status    String   @default("IN_PROGRESS")
  createdAt DateTime @default(now())

  @@index([userId])
}

model NegotiationSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String?
  title      String
  target     String   @default("")
  floor      String   @default("")
  offer      String   @default("")
  difficulty String   @default("medium")
  script     String   @default("")
  transcript String   @default("[]")
  report     String   @default("{}")
  status     String   @default("SETUP")
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Reminder {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title      String
  body       String    @default("")
  dueAt      DateTime
  done       Boolean   @default(false)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, dueAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  module    String   @default("assistant")
  jobId     String?
  rating    Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

/// Onboarding answers (spec §4). Arrays keep user order; locations max 10.
model JobPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRoles         String[]
  /// Ordered city names, max 10. Remote options are NOT stored here.
  locations           String[]
  remoteIndia         Boolean  @default(false)
  remoteInternational Boolean  @default(false)
  /// subset of remote | hybrid | onsite
  workArrangements    String[]
  /// subset of full_time | part_time | contract
  employmentTypes     String[]
  experienceYears     Int      @default(0)
  currentCtcLakhs     Float?
  expectedCtcLakhs    Float?
  noticePeriodDays    Int?
  industries          String[]
  skills              String[]
  willingToRelocate   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Provider-agnostic subscription state (spec §15). Written only via applyBillingEvent.
model BillingAccount {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider               String    @default("razorpay")
  state                  String    @default("none")
  trialEndsAt            DateTime?
  periodEnd              DateTime?
  appliedPayments        String[]
  providerCustomerId     String?
  providerSubscriptionId String?   @unique
  version                Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

/// Every verified provider webhook, keyed "provider:eventId" for idempotency, plus audit of transitions.
model BillingEventLog {
  id        String   @id
  provider  String
  type      String
  userId    String?
  fromState String?
  toState   String?
  outcome   String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// DPDP consent ledger: purpose-specific, timestamped, withdrawable.
model ConsentRecord {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       String
  noticeVersion String
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?

  @@index([userId, purpose])
}

/// Manual UPI payment awaiting admin verification (BILLING_PROVIDER=upi_manual).
model UpiPayment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ref         String    @unique
  utr         String    @unique
  amountPaise Int
  /// pending | approved | rejected
  status      String    @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  note        String    @default("")
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// Append-only log of admin actions.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  targetType String
  targetId   String
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

/// Admin notifications (e.g. UPI auto-activation). Always stored; emailed when a mailer is configured.
model AdminNotification {
  id        String   @id @default(cuid())
  kind      String
  to        String
  subject   String
  body      String
  /// resend | smtp | console | failed
  sentVia   String
  error     String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Job Hunt Agent: employers whose public ATS boards are polled.
model HuntCompany {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  /// greenhouse | lever | ashby | smartrecruiters
  ats           String
  boardToken    String
  industry      String    @default("")
  /// seed | user | csv | suggestion
  source        String    @default("user")
  enabled       Boolean   @default(true)
  lastFetchedAt DateTime?
  lastStatus    String    @default("")
  createdAt     DateTime  @default(now())

  @@unique([userId, ats, boardToken])
  @@index([userId])
}

model HuntSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threshold              Int      @default(70)
  allowedCountries       String[] @default(["India", "United Arab Emirates", "United Kingdom", "Germany", "Netherlands"])
  allowUsWithSponsorship Boolean  @default(true)
  needsSponsorship       Boolean  @default(false)
  homeCountry            String   @default("India")
  companiesPerRun        Int      @default(300)
  autoRun                Boolean  @default(false)
  /// Local time of day for the daily run, in `timezone`.
  autoRunHour            Int      @default(8)
  autoRunMinute          Int      @default(0)
  timezone               String   @default("Asia/Kolkata")
  lastAutoRunAt          DateTime?
  /// Only postings published within this many days are considered.
  freshnessDays          Int      @default(3)
  /// Postings with no reliable date: excluded unless true.
  includeUnknownDate     Boolean  @default(false)
  remoteAbroad           Boolean  @default(true)
  hybridAbroad           Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model HuntRun {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger    String    @default("manual")
  status     String    @default("running")
  companies  Int       @default(0)
  fetched    Int       @default(0)
  relevant   Int       @default(0)
  fresh      Int       @default(0)
  queued     Int       @default(0)
  skipped    Int       @default(0)
  stale      Int       @default(0)
  undated    Int       @default(0)
  locationSkipped Int  @default(0)
  errors     String    @default("[]")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([userId, startedAt])
}

/// Every reviewed posting (dedup key = hash of ats|board|externalId|url). Never resurfaced.
model HuntJob {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  runId       String?
  company     String
  ats         String
  externalId  String
  title       String
  location    String    @default("")
  country     String    @default("")
  url         String
  score       Int       @default(0)
  scoreDetail String    @default("{}")
  /// queued | skipped | applied | dismissed
  decision    String
  skipReason  String    @default("")
  tailored    String    @default("")
  /// JSON ResumeContent of the guardrailed per-role tailored resume (PDF/DOCX are rendered from it).
  tailoredContent String @default("{}")
  postedAt    DateTime?
  /// exact | approx | unknown
  dateKind    String    @default("unknown")
  source      String    @default("ats")
  answers     String    @default("[]")
  needsInput  String[]
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, key])
  @@index([userId, decision])
}

/// Saved answers bank used to prefill applications.
model SavedAnswer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// In-app notifications (always on); email is sent in addition when a mailer is configured.
model UserNotice {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    @default("hunt")
  title     String
  body      String    @default("")
  href      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
