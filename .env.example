# Copy to .env for local development. `npm run dev` does this automatically
# when .env is missing. Rotate every secret before any shared deployment.

DATABASE_URL="file:./dev.db"

# Auth.js. The value below is for local demo only.
AUTH_SECRET="b5072a64f0047f1f27ee6382bfb34f395872ad604395c4c728a31236e01c0af8"
AUTH_TRUST_HOST="true"

# OpenAI-compatible chat completions. Leave LLM_API_KEY empty for mock mode.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
# Set to 1 to force mock replies even when a key is present.
LLM_MOCK=""

# Optional job boards. Search still works from the built-in sample market.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="in"
JSEARCH_API_KEY=""
JSEARCH_API_HOST="jsearch.p.rapidapi.com"

