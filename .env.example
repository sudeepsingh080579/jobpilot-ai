# Copy to .env for local development. `npm run dev` does this when .env is missing.
# The values below are for a laptop only. Replace every secret before a shared deploy.

# Local Postgres from `docker compose up -d`. Same URL for runtime and migrations.
DATABASE_URL="postgresql://jobpilot:jobpilot@127.0.0.1:5432/jobpilot?schema=public"
DIRECT_URL="postgresql://jobpilot:jobpilot@127.0.0.1:5432/jobpilot?schema=public"

# Set to 1 to insert the demo user. Leave unset on Vercel unless you want that desk.
SEED_DEMO="1"

# Auth.js. The value below is for local demo only.
AUTH_SECRET="b5072a64f0047f1f27ee6382bfb34f395872ad604395c4c728a31236e01c0af8"
# Production only. Set this in Vercel to https://your-project.vercel.app
# Leave it unset locally so the session cookie works on http://127.0.0.1.
# AUTH_URL="https://your-project.vercel.app"
AUTH_TRUST_HOST="true"

# OpenAI-compatible chat completions. Leave LLM_API_KEY empty for mock mode.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
# Set to 1 to force mock replies even when a key is present.
LLM_MOCK=""

# Optional job boards. Search still works from the built-in sample market.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="in"
JSEARCH_API_KEY=""
JSEARCH_API_HOST="jsearch.p.rapidapi.com"

# Web Push. Dev keys below are local-only. Generate your own for production:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BGXOH09VB1cBW9F1o9_BUkb-tEFhAkebncD8dfdUmfpOs3CJ9Wyn6Np61jvauXg95-O92txH277oFFsvsxXBPCY"
VAPID_PRIVATE_KEY="7wsVKSNEBzzBFbSg8wt8DMIBLVRA4l3rpJLpKvV3P9A"
VAPID_SUBJECT="mailto:demo@jobpilot.local"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BGXOH09VB1cBW9F1o9_BUkb-tEFhAkebncD8dfdUmfpOs3CJ9Wyn6Np61jvauXg95-O92txH277oFFsvsxXBPCY"

# Optional. When set, resume files go to Vercel Blob instead of Postgres.
BLOB_READ_WRITE_TOKEN=""
