{
  "name": "jobpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 41731",
    "predev": "node scripts/ensure-env.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 41731",
    "db:prepare": "node scripts/ensure-env.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "db:reset": "node scripts/ensure-env.mjs && prisma migrate reset --force",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
